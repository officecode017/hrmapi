# Database Configuration
ConnectionStrings__DefaultConnection=Server=localhost;Database=HRAttendanceDb;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True

# JWT Configuration
Jwt__Key=YourSuperSecretKeyThatMustBeAtLeast32BytesLongForSecurity!
Jwt__Issuer=HRAttendance
Jwt__Audience=HRAttendanceApp
Jwt__ExpiryMinutes=120

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
